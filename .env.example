SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GEMINI_API_KEY=your-gemini-api-key
# (선택) 쓸 모델 순서, 쉼표로 구분. 비우면 코드 기본값(core/config.py) 사용
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.6-flash

KAKAO_CLIENT_ID=your-kakao-rest-api-key
# (선택) 카카오 개발자 콘솔의 숫자 앱 ID. 로그인 토큰이 이 앱에서 발급됐는지 확인한다. 0이면 확인 생략
# KAKAO_APP_ID=1234567
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# 개인정보 암호화 키 (AES-256) - python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=your-64-char-hex-string

# 가명처리 시크릿 (HMAC-SHA256) - python -c "import os; print(os.urandom(32).hex())"
PSEUDONYM_SECRET=your-64-char-hex-string

# IP 해시 솔트 - python -c "import os; print(os.urandom(16).hex())"
IP_HASH_SALT=your-32-char-hex-string

# 운영(Render)에서는 반드시 false — true면 /docs·/openapi.json이 공개되고 CORS가 전체 허용된다
DEBUG=false
